# --- Payments: "test" (default; Stripe test keys only) or "live" (real payments: live keys,
# STRIPE_WEBHOOK_SECRET and SMTP_URL required; see README "Going live" and Admin → Go-live checklist)
PAYMENTS_MODE=test

# --- Stripe (test keys while PAYMENTS_MODE=test)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
# From `stripe listen --forward-to localhost:3000/webhooks/stripe`
STRIPE_WEBHOOK_SECRET=whsec_...

# --- App
PORT=3000
BASE_URL=http://localhost:3000
# On Hostinger web hosting put this OUTSIDE the app folder, e.g. /home/u123456789/groupbuy-data/groupbuy.sqlite
DATABASE_PATH=./data/groupbuy.sqlite
# Where /api/cron/backup writes copies (default: a "backups" folder next to the database)
BACKUP_DIR=
BACKUP_KEEP=14
# WAL (default) or DELETE if the host's filesystem doesn't support WAL ("disk I/O error" at startup)
SQLITE_JOURNAL_MODE=WAL
# Number of reverse proxies in front of the app (Hostinger, nginx, Caddy: 1)
TRUST_PROXY=1
# Long random string, used to sign admin CSRF tokens
APP_SECRET=change-me-to-a-long-random-string
ADMIN_USER=admin
ADMIN_PASSWORD=change-me
# Where "Forgot your password?" on the admin login page sends the reset link (needs SMTP_URL).
# Empty: the shop's contact email (BUSINESS_EMAIL, or Admin → Settings → Shop details).
ADMIN_EMAIL=
# Two-step login is turned on in Admin → Settings → Two-step login. Lost the phone and the backup
# codes? Set this to "off" and restart: the password alone works until you turn it on again.
ADMIN_TWO_STEP=
# Protects POST /api/cron/tick and /api/cron/backup. Required on Hostinger web hosting,
# where an hPanel cron job must call /api/cron/tick every minute (the app sleeps when idle).
CRON_SECRET=change-me-too
SCHEDULER_INTERVAL_MS=60000
# Max join attempts per IP per 15 minutes
JOIN_RATE_LIMIT=10

# --- Email: leave SMTP_URL empty to print emails to the console (they are also kept in the admin outbox)
# Hostinger mailbox: smtps://shop%40yourdomain.com:URL-ENCODED-PASSWORD@smtp.hostinger.com:465
SMTP_URL=
MAIL_FROM=Group Buy <no-reply@example.com>

# --- Stripe Tax product tax code for deals (default: General - Tangible Goods)
DEFAULT_TAX_CODE=txcd_99999999

# --- Business details shown in the footer, terms and privacy policy
BUSINESS_NAME=
BUSINESS_ADDRESS=
BUSINESS_EMAIL=
# Required by EU consumer law next to the address and email, e.g. +372 5123 4567
BUSINESS_PHONE=
BUSINESS_VAT_ID=
BUSINESS_REGISTRATION=
BUSINESS_DPA=

# --- Product photos (admin uploads). Default: an "uploads" folder next to DATABASE_PATH.
# On Hostinger keep it OUTSIDE the app folder, e.g. /home/u123456789/groupbuy-data/uploads
UPLOAD_DIR=

# --- The shop's main language (two-letter code): deals are written in it, visitors whose browser
# language the shop doesn't offer get it, and it is always on. Default: et (Estonian).
# Pick the other languages in Admin → Settings → Languages.
CONTENT_LANGUAGE=

# --- AI shopping assistant (chat window on the public pages). Off while ANTHROPIC_API_KEY is empty.
# Create a key at https://platform.claude.com (Settings → API keys).
ANTHROPIC_API_KEY=
ASSISTANT_MODEL=claude-opus-5-5
# Messages per visitor (IP) per 15 minutes, and for the whole site per day (caps API spend)
ASSISTANT_RATE_LIMIT=30
ASSISTANT_DAILY_LIMIT=1000
