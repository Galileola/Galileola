# --- Stripe (TEST MODE ONLY: the app refuses to start with live keys)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
# From `stripe listen --forward-to localhost:3000/webhooks/stripe`
STRIPE_WEBHOOK_SECRET=whsec_...

# --- App
PORT=3000
BASE_URL=http://localhost:3000
# On Hostinger web hosting put this OUTSIDE the app folder, e.g. /home/u123456789/groupbuy-data/groupbuy.sqlite
DATABASE_PATH=./data/groupbuy.sqlite
# Where /api/cron/backup writes copies (default: a "backups" folder next to the database)
BACKUP_DIR=
BACKUP_KEEP=14
# WAL (default) or DELETE if the host's filesystem doesn't support WAL ("disk I/O error" at startup)
SQLITE_JOURNAL_MODE=WAL
# Number of reverse proxies in front of the app (Hostinger, nginx, Caddy: 1)
TRUST_PROXY=1
# Long random string, used to sign admin CSRF tokens
APP_SECRET=change-me-to-a-long-random-string
ADMIN_USER=admin
ADMIN_PASSWORD=change-me
# Protects POST /api/cron/tick and /api/cron/backup. Required on Hostinger web hosting,
# where an hPanel cron job must call /api/cron/tick every minute (the app sleeps when idle).
CRON_SECRET=change-me-too
SCHEDULER_INTERVAL_MS=60000
# Max join attempts per IP per 15 minutes
JOIN_RATE_LIMIT=10

# --- Email: leave SMTP_URL empty to print emails to the console (they are also kept in the admin outbox)
# Hostinger mailbox: smtps://shop%40yourdomain.com:URL-ENCODED-PASSWORD@smtp.hostinger.com:465
SMTP_URL=
MAIL_FROM=Group Buy <no-reply@example.com>

# --- Stripe Tax product tax code for deals (default: General - Tangible Goods)
DEFAULT_TAX_CODE=txcd_99999999

# --- Business details shown in the footer, terms and privacy policy
BUSINESS_NAME=
BUSINESS_ADDRESS=
BUSINESS_EMAIL=
BUSINESS_VAT_ID=
BUSINESS_REGISTRATION=
BUSINESS_DPA=
