<%- include('partials/header') %>
<section class="card narrow stack">
  <h1><%= t('pay.title') %></h1>
  <p><strong><%= deal.product_name %></strong> · <%= formatEuro(p.amount_cents) %> <%= t('price.inclVat') %><% if (p.tax_cents != null) { %> <span class="muted small">(<%= t('price.vat', { amount: formatEuro(p.tax_cents) }) %>)</span><% } %></p>
  <div class="notice <%= p.needs_authentication ? 'warn' : 'bad' %>">
    <% if (p.needs_authentication) { %>
      <%= t('pay.sca') %>
    <% } else { %>
      <%= p.last_error_message ? t('pay.failedReason', { reason: p.last_error_message }) : t('pay.failed') %>
    <% } %>
    <%- th('pay.deadlineHtml', { date: formatDate(p.grace_ends_at) }) %>
  </div>
  <% if (error) { %><div class="notice bad"><%= t('pay.error') %></div><% } %>

  <div id="pay" data-pk="<%= publishableKey %>" data-secret="<%= clientSecret %>" data-return="<%= returnUrl %>"
       data-saved="<%= canReuseSavedCard ? p.payment_method_id : '' %>" data-name="<%= p.name %>" data-email="<%= p.email %>"
       data-country="<%= p.country %>" data-locale="<%= stripeLocale %>" data-business="<%= business.name %>">
    <% if (canReuseSavedCard) { %>
      <h2><%= p.needs_authentication ? t('pay.confirmTitle') : t('pay.retryTitle') %></h2>
      <p><%= p.payment_method_label %></p>
      <p><button type="button" id="pay-saved"><%= p.needs_authentication ? t('pay.confirmButton') : t('pay.savedButton') %></button></p>
      <p class="muted small"><%= t('pay.orOther') %></p>
    <% } %>
    <form id="pay-form">
      <div id="payment-element"></div>
      <button type="submit" id="pay-submit"><%= t('pay.payButton', { amount: formatEuro(p.amount_cents) }) %></button>
    </form>
    <p id="pay-error" class="error-text" role="alert"></p>
  </div>
</section>
<script src="/static/js/pay.js"></script>
<%- include('partials/footer') %>
