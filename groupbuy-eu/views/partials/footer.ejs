  </main>
  <footer class="site-footer">
    <div class="site-footer-inner">
      <p class="footer-brand"><% if (brand.logo) { %><img class="brand-logo" src="<%= brand.logo %>" alt="" width="24" height="24"><% } else { %><span class="brand-mark" aria-hidden="true"></span><% } %><%= brand.name %></p>
      <p><%= business.name %> · <%= business.address %> · <%= t('footer.vat', { id: business.vatId }) %></p>
      <p>
        <a href="/terms"><%= t('footer.terms') %></a> ·
        <a href="/privacy"><%= t('footer.privacy') %></a> ·
        <a href="/cookies"><%= t('footer.cookies') %></a> ·
        <button type="button" class="linklike" data-cookie-settings><%= t('footer.cookieSettings') %></button>
      </p>
    </div>
  </footer>
  <div class="cookie-banner" id="cookie-banner" role="dialog" aria-live="polite" aria-label="<%= t('cookieBanner.label') %>" hidden>
    <strong><%= t('cookieBanner.title') %></strong>
    <p class="small"><%= t('cookieBanner.text') %> <a href="/cookies"><%= t('cookieBanner.details') %></a></p>
    <div class="actions">
      <% if (locals.optionalCookies) { %>
      <button type="button" data-consent="necessary"><%= t('cookieBanner.necessary') %></button>
      <button type="button" data-consent="all"><%= t('cookieBanner.all') %></button>
      <% } else { %>
      <button type="button" data-consent="necessary"><%= t('cookieBanner.ok') %></button>
      <% } %>
    </div>
  </div>
  <% if (assistantEnabled) { %><%- include('assistant') %><% } %>
  <script src="<%= asset('/static/js/fun.js') %>"></script>
  <script src="<%= asset('/static/js/cookies.js') %>"></script>
</body>
</html>
