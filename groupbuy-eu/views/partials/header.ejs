<% const brandName = business.name.startsWith('[') ? 'Group Buy' : business.name; %>
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#6d28d9">
  <title><%= title %> · <%= brandName %></title>
  <link rel="stylesheet" href="/static/css/site.css">
  <% if (loadStripe) { %><script src="https://js.stripe.com/v3/"></script><% } %>
</head>
<body>
  <div class="test-banner">Test mode: no real payments are taken. Use Stripe test cards and IBANs only.</div>
  <header class="site-header">
    <div class="site-header-inner">
      <a class="brand" href="/"><span class="brand-mark" aria-hidden="true"></span><%= brandName %></a>
      <% if (isAdmin) { %>
        <nav aria-label="Admin"><a href="/admin">Deals</a><a href="/admin/snap" class="nav-snap">📸 Snap a deal</a><a href="/admin/emails">Emails</a><a href="/admin/password">🔑 Password</a><a href="/">Shop</a></nav>
      <% } else { %>
        <nav><a href="/#categories">Categories</a><a href="/#deals">Deals</a><a href="/#how">How it works</a></nav>
      <% } %>
    </div>
  </header>
  <main class="container">
