<% const brandName = business.name.startsWith('[') ? 'Group Buy' : business.name; %>
<!doctype html>
<html lang="<%= lang %>">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#6d28d9">
  <title><%= title %> · <%= brandName %></title>
  <link rel="stylesheet" href="/static/css/site.css">
  <% if (isAdmin || noindex) { %>
    <meta name="robots" content="noindex, nofollow">
  <% } else { %>
    <% const m = meta || {}; const pageUrl = baseUrl + langUrl(lang); const description = m.description || t('home.lead'); %>
    <meta name="description" content="<%= description %>">
    <link rel="canonical" href="<%= pageUrl %>">
    <% for (const l of languages) { %><link rel="alternate" hreflang="<%= l.code %>" href="<%= baseUrl + langUrl(l.code) %>">
    <% } %><link rel="alternate" hreflang="x-default" href="<%= baseUrl + langUrl('en') %>">
    <meta property="og:site_name" content="<%= brandName %>">
    <meta property="og:type" content="<%= m.type || 'website' %>">
    <meta property="og:title" content="<%= m.title || title %>">
    <meta property="og:description" content="<%= description %>">
    <meta property="og:url" content="<%= pageUrl %>">
    <meta property="og:locale" content="<%= ogLocale %>">
    <% if (m.image) { %><meta property="og:image" content="<%= m.image %>">
    <meta property="og:image:alt" content="<%= m.title || title %>"><% } %>
    <meta name="twitter:card" content="<%= m.image ? 'summary_large_image' : 'summary' %>">
    <% if (m.priceAmount) { %><meta property="product:price:amount" content="<%= m.priceAmount %>">
    <meta property="product:price:currency" content="EUR"><% } %>
    <% if (m.jsonLd) { %><script type="application/ld+json"><%- JSON.stringify(m.jsonLd).replace(/</g, '\\u003c') %></script><% } %>
  <% } %>
  <% if (loadStripe) { %><script src="https://js.stripe.com/v3/"></script><% } %>
</head>
<body>
  <script type="application/json" id="gb-i18n"><%- JSON.stringify(clientStrings).replace(/</g, '\\u003c') %></script>
  <div class="test-banner"><%= t('layout.testBanner') %></div>
  <header class="site-header">
    <div class="site-header-inner">
      <a class="brand" href="/"><span class="brand-mark" aria-hidden="true"></span><%= brandName %></a>
      <% if (isAdmin) { %>
        <nav aria-label="Admin"><a href="/admin">Deals</a><a href="/admin/snap" class="nav-snap">📸 Snap a deal</a><a href="/admin/performance">📊 Performance</a><a href="/admin/emails">Emails</a><a href="/admin/settings">⚙️ Settings</a><a href="/">Shop</a></nav>
      <% } else { %>
        <nav class="shop-nav"><a href="/#categories"><%= t('nav.categories') %></a><a href="/#deals"><%= t('nav.deals') %></a><a href="/#how"><%= t('nav.how') %></a></nav>
        <details class="lang-menu" data-lang-menu>
            <summary aria-label="<%= t('layout.language') %>: <%= currentLanguage.name %>"><span aria-hidden="true">🌐</span> <span class="lang-code"><%= lang.toUpperCase() %></span></summary>
            <ul>
              <% for (const l of languages) { %><li><a href="<%= langUrl(l.code) %>" hreflang="<%= l.code %>" lang="<%= l.code %>"<%- l.code === lang ? ' aria-current="true"' : '' %>><%= l.name %></a></li>
              <% } %>
            </ul>
        </details>
      <% } %>
    </div>
  </header>
  <main class="container">
