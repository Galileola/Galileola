<div class="assistant-widget" id="assistant">
  <button type="button" class="assistant-launcher" data-assistant-open aria-expanded="false" aria-controls="assistant-panel">
    <span class="assistant-dot" aria-hidden="true"></span><%= t('assistant.open') %>
  </button>
  <section class="assistant-panel" id="assistant-panel" role="dialog" aria-label="<%= t('assistant.title') %>" hidden>
    <header class="assistant-head">
      <div>
        <strong><%= t('assistant.title') %></strong>
        <span><%= t('assistant.subtitle') %></span>
      </div>
      <button type="button" class="assistant-close" data-assistant-close aria-label="<%= t('assistant.close') %>">×</button>
    </header>
    <div class="assistant-log" data-assistant-log aria-live="polite">
      <div class="msg assistant"><%= t('assistant.welcome') %></div>
    </div>
    <div class="assistant-suggestions" data-assistant-suggestions>
      <button type="button" data-suggest><%= t('assistant.suggest1') %></button>
      <button type="button" data-suggest><%= t('assistant.suggest2') %></button>
      <button type="button" data-suggest><%= t('assistant.suggest3') %></button>
    </div>
    <form class="assistant-form" data-assistant-form>
      <textarea name="message" rows="1" maxlength="1500" placeholder="<%= t('assistant.placeholder') %>" aria-label="<%= t('assistant.inputLabel') %>"></textarea>
      <button type="submit"><%= t('assistant.send') %></button>
    </form>
    <p class="assistant-note"><%= t('assistant.note') %></p>
  </section>
</div>
<script src="<%= asset('/static/js/assistant.js') %>"></script>
