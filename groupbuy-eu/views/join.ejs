<%- include('partials/header') %>
<section class="card narrow">
  <h1><%= t('setup.title') %></h1>
  <p><strong><%= deal.product_name %></strong> · <%= formatEuro(p.amount_cents ?? deal.price_cents) %> <%= t('price.inclVat') %><% if (p.tax_cents != null) { %> <span class="muted small">(<%= t('price.vat', { amount: formatEuro(p.tax_cents) }) %><%= p.tax_rate_label ? ', ' + p.tax_rate_label : '' %>)</span><% } %></p>
  <% if (deal.status === 'open') { %>
    <div class="notice"><%- th('setup.noChargeHtml', { min: deal.min_buyers, date: formatDate(deal.deadline) }) %></div>
  <% } else { %>
    <div class="notice ok"><%= t('setup.reached') %></div>
  <% } %>
  <% if (failed) { %><div class="notice bad"><%= t('setup.failed') %></div><% } %>
  <form id="setup-form"
        data-pk="<%= publishableKey %>"
        data-secret="<%= clientSecret %>"
        data-return="<%= returnUrl %>"
        data-name="<%= p.name %>"
        data-email="<%= p.email %>"
        data-country="<%= p.country %>"
        data-locale="<%= stripeLocale %>"
        data-business="<%= business.name %>">
    <div id="payment-element"></div>
    <p class="muted small"><%= t('setup.methods') %></p>
    <p id="setup-error" class="error-text" role="alert"></p>
    <button type="submit" id="setup-submit"><%= t('setup.submit') %></button>
  </form>
</section>
<script src="<%= asset('/static/js/setup.js') %>"></script>
<%- include('partials/footer') %>
