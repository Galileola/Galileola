<%- include('partials/header') %>
<section class="hero">
  <div class="hero-text">
    <p class="eyebrow">🎉 Group deals across the EU</p>
    <h1>Buy together.<br><span class="hl">Pay less.</span></h1>
    <p class="lead">Team up with other shoppers. When enough people join a deal, everyone gets the group price. Not enough? Nobody pays a cent.</p>
    <p class="hero-actions">
      <a class="button big" href="#deals">Find a deal 🛍️</a>
      <a class="button big secondary" href="#how">How it works</a>
    </p>
    <ul class="hero-stats" aria-label="Right now">
      <li><strong><%= stats.open %></strong> open deal<%= stats.open === 1 ? '' : 's' %></li>
      <li><strong><%= stats.buyers %></strong> buyer<%= stats.buyers === 1 ? '' : 's' %> joined</li>
      <% if (stats.hot) { %><li class="hot"><strong><%= stats.hot %></strong> almost there 🔥</li><% } %>
    </ul>
  </div>
  <div class="hero-art" aria-hidden="true">
    <span class="bubble b1">🎧</span><span class="bubble b2">👟</span><span class="bubble b3">🍫</span>
    <span class="bubble b4">🧸</span><span class="bubble b5">☕</span><span class="bubble b6">🌱</span>
  </div>
</section>

<section class="steps" id="how" aria-label="How it works">
  <div class="step s1"><span class="num">1</span><h3>🙋 Join a deal</h3><p>Save a card, SEPA account or iDEAL. Nothing is charged yet.</p></div>
  <div class="step s2"><span class="num">2</span><h3>📣 Bring friends</h3><p>Share the deal. The bar fills up as more buyers join.</p></div>
  <div class="step s3"><span class="num">3</span><h3>🎉 The deal is on</h3><p>Minimum reached: everyone pays the group price. Not reached: nobody pays.</p></div>
</section>

<nav class="category-bar" id="categories" aria-label="Categories">
  <a class="cat-chip<%= category ? '' : ' active' %>" href="/#deals"<%- category ? '' : ' aria-current="page"' %>><span class="cat-emoji" aria-hidden="true">✨</span>All<span class="cat-count"><%= stats.open %></span></a>
  <% for (const c of categories) { const n = perCategory[c.slug] || 0; const active = category && category.slug === c.slug; %>
    <a class="cat-chip<%= active ? ' active' : '' %><%= n ? '' : ' none' %>" href="/?category=<%= c.slug %>#deals"<%- active ? ' aria-current="page"' : '' %>>
      <span class="cat-emoji" aria-hidden="true"><%= c.emoji %></span><%= c.name %><% if (n) { %><span class="cat-count"><%= n %></span><% } %>
    </a>
  <% } %>
</nav>

<h2 class="section-title" id="deals">
  <% if (category) { %><%= category.emoji %> <%= category.name %><% } else { %>Current group deals<% } %>
</h2>
<% if (!deals.length) { %>
  <div class="empty-state">
    <p class="empty-emoji" aria-hidden="true"><%= category ? category.emoji : '🛒' %></p>
    <% if (category) { %>
      <p><strong>No <%= category.name.toLowerCase() %> deals right now.</strong></p>
      <p class="muted">New deals are added all the time. <a href="/#deals">See all deals</a></p>
    <% } else { %>
      <p><strong>No deals are open right now.</strong></p>
      <p class="muted">New deals are added regularly. Check back soon.</p>
    <% } %>
  </div>
<% } %>
<div class="grid deals-grid">
<% deals.forEach((d, i) => { %>
  <%- include('partials/deal-card', { d, i }) %>
<% }) %>
</div>
<%- include('partials/footer') %>
