<%- include('partials/header') %>
<section class="hero">
  <div class="hero-text">
    <p class="eyebrow"><%= t('home.eyebrow') %></p>
    <h1><%= t('home.heroLine1') %><br><span class="hl"><%= t('home.heroLine2') %></span></h1>
    <p class="lead"><%= t('home.lead') %></p>
    <p class="hero-actions">
      <a class="button big" href="#deals"><%= t('home.findDeal') %></a>
      <a class="button big secondary" href="#how"><%= t('home.howItWorks') %></a>
    </p>
    <ul class="hero-stats" aria-label="<%= t('home.statsLabel') %>">
      <li><%- th('home.statOpenHtml', { count: stats.open }) %></li>
      <li><%- th('home.statBuyersHtml', { count: stats.buyers }) %></li>
      <% if (stats.hot) { %><li class="hot"><%- th('home.statHotHtml', { count: stats.hot }) %></li><% } %>
    </ul>
  </div>
  <div class="hero-art" aria-hidden="true">
    <span class="bubble b1">🎧</span><span class="bubble b2">👟</span><span class="bubble b3">🍫</span>
    <span class="bubble b4">🧸</span><span class="bubble b5">☕</span><span class="bubble b6">🌱</span>
  </div>
</section>

<section class="steps" id="how" aria-labelledby="how-title">
  <h2 class="visually-hidden" id="how-title"><%= t('home.howItWorks') %></h2>
  <div class="step s1"><span class="num">1</span><h3><%= t('home.step1Title') %></h3><p><%= t('home.step1Text') %></p></div>
  <div class="step s2"><span class="num">2</span><h3><%= t('home.step2Title') %></h3><p><%= t('home.step2Text') %></p></div>
  <div class="step s3"><span class="num">3</span><h3><%= t('home.step3Title') %></h3><p><%= t('home.step3Text') %></p></div>
</section>

<nav class="category-bar" id="categories" aria-label="<%= t('nav.categories') %>">
  <a class="cat-chip<%= category ? '' : ' active' %>" href="/#deals"<%- category ? '' : ' aria-current="page"' %>><span class="cat-emoji" aria-hidden="true">✨</span><%= t('home.all') %><span class="cat-count"><%= stats.open %></span></a>
  <% for (const c of categories) { const n = perCategory[c.slug] || 0; const active = category && category.slug === c.slug; %>
    <a class="cat-chip<%= active ? ' active' : '' %><%= n ? '' : ' none' %>" href="/?category=<%= c.slug %>#deals"<%- active ? ' aria-current="page"' : '' %>>
      <span class="cat-emoji" aria-hidden="true"><%= c.emoji %></span><%= c.name %><% if (n) { %><span class="cat-count"><%= n %></span><% } %>
    </a>
  <% } %>
</nav>

<div class="deals-head">
  <h2 class="section-title" id="deals">
    <% if (q) { %><%= t('home.searchResults', { q }) %><% } else if (category) { %><%= category.emoji %> <%= category.name %><% } else { %><%= t('home.currentDeals') %><% } %>
  </h2>
  <form class="deal-search" method="get" action="/" role="search">
    <% if (category) { %><input type="hidden" name="category" value="<%= category.slug %>"><% } %>
    <label class="visually-hidden" for="deal-search"><%= t('home.searchLabel') %></label>
    <input type="search" id="deal-search" name="q" value="<%= q %>" placeholder="<%= t('home.searchPlaceholder') %>" maxlength="100" enterkeyhint="search">
    <button type="submit"><span aria-hidden="true">🔍</span><span class="visually-hidden"><%= t('home.searchButton') %></span></button>
  </form>
</div>
<% if (!deals.length) { %>
  <div class="empty-state">
    <p class="empty-emoji" aria-hidden="true"><%= q ? '🔍' : category ? category.emoji : '🛒' %></p>
    <% if (q) { %>
      <p><strong><%= t('home.noResults') %></strong></p>
      <p class="muted"><a href="/#deals"><%= t('home.seeAll') %></a></p>
    <% } else if (category) { %>
      <p><strong><%= t('home.noCategoryDeals') %></strong></p>
      <p class="muted"><%= t('home.newDealsOften') %> <a href="/#deals"><%= t('home.seeAll') %></a></p>
    <% } else { %>
      <p><strong><%= t('home.noDeals') %></strong></p>
      <p class="muted"><%= t('home.checkBack') %></p>
    <% } %>
  </div>
<% } %>
<div class="grid deals-grid">
<% deals.forEach((d, i) => { %>
  <%- include('partials/deal-card', { d, i }) %>
<% }) %>
</div>

<section class="alert-signup" id="alerts" aria-labelledby="alerts-title">
  <div>
    <h2 id="alerts-title"><%= t('alerts.title') %></h2>
    <p><%= t('alerts.text') %></p>
  </div>
  <form method="post" action="/alerts" class="alert-form">
    <label class="visually-hidden" for="alert-email"><%= t('alerts.emailLabel') %></label>
    <input type="email" id="alert-email" name="email" required autocomplete="email" inputmode="email" placeholder="<%= t('alerts.emailLabel') %>">
    <div class="hp" aria-hidden="true"><label for="alert-website">Website</label><input type="text" id="alert-website" name="website" tabindex="-1" autocomplete="off"></div>
    <button type="submit"><%= t('alerts.button') %></button>
  </form>
  <p class="small alert-privacy"><%= t('alerts.privacyNote') %> <a href="/privacy"><%= t('footer.privacy') %></a></p>
</section>
<%- include('partials/footer') %>
