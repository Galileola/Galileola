<%- include('../partials/header') %>
<p><a href="/admin">← Admin</a></p>
<h1>⚙️ Settings</h1>
<div class="grid settings-grid">
  <a class="card settings-card" href="/admin/business">
    <h2>🏢 Shop details</h2>
    <p class="muted">Company name, address, contact email, VAT number and registration. Shown in the footer, the legal pages and the emails.</p>
  </a>
  <a class="card settings-card" href="/admin/branding">
    <h2>🎨 Branding &amp; search</h2>
    <p class="muted">Shop name, logo and app icon, the picture for shared links, the home page's search title, and Google and Bing verification.</p>
  </a>
  <a class="card settings-card" href="/admin/languages">
    <h2>🌐 Languages</h2>
    <p class="muted">Choose which languages the shop offers in its language menu. Deals are translated into these.</p>
  </a>
  <a class="card settings-card" href="/admin/delivery">
    <h2>🚚 Delivery countries</h2>
    <p class="muted">Choose which EU countries you deliver to. Only these can be picked in the order form.</p>
  </a>
  <a class="card settings-card" href="/admin/categories">
    <h2>🗂️ Categories</h2>
    <p class="muted">Add, rename, reorder or remove the categories shoppers filter by, with a name for each language.</p>
  </a>
  <a class="card settings-card" href="/admin/legal">
    <h2>📄 Legal pages</h2>
    <p class="muted">Terms and conditions, privacy policy and cookie page, with your own text for each language.</p>
  </a>
  <a class="card settings-card" href="/admin/go-live">
    <h2>🚀 Go-live checklist</h2>
    <p class="muted">What's ready and what's still missing before the shop takes real payments.</p>
  </a>
  <a class="card settings-card" href="/admin/security">
    <h2>🛡️ Two-step login</h2>
    <p class="muted">Ask for a code from an app on your phone after the password, so a stolen password alone can't open the admin.</p>
  </a>
  <a class="card settings-card" href="/admin/password">
    <h2>🔑 Password</h2>
    <p class="muted">Change the password for this admin.</p>
  </a>
</div>
<%- include('../partials/footer') %>
