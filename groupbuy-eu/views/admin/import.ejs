<%- include('../partials/header') %>
<p><a href="/admin">← Admin</a></p>
<section class="card narrow">
  <h1>📥 Import products</h1>
  <p>Upload a CSV file of products from another shop. You'll see a preview first and choose which products become deals.</p>
  <ul class="small import-formats">
    <li><strong>Shopify:</strong> Products → Export → "Plain CSV file".</li>
    <li><strong>WooCommerce:</strong> Products → Export → "Export products".</li>
    <li><strong>Any other site or a spreadsheet:</strong> a CSV with a header row. It needs a name column ("name", "title" or "product"). It can also have price, description, headline, category, min_buyers, days and image URL columns. <a href="/admin/import/template.csv">Download the template</a>.</li>
  </ul>
  <% if (error) { %><div class="notice bad"><%= error %></div><% } %>
  <form method="post" action="/admin/import" enctype="multipart/form-data">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <label for="file">CSV file (up to <%= maxMb %> MB and <%= maxProducts %> products)</label>
    <input type="file" id="file" name="file" accept=".csv,text/csv,text/plain" required class="file-input">

    <div class="row">
      <div>
        <label for="discount">Group discount, % off the file's price</label>
        <input type="number" id="discount" name="discount" min="0" max="90" step="0.5" value="<%= values.discount %>">
        <p class="muted small">0 keeps the price as it is. Prices are read as euros, VAT included.</p>
      </div>
      <div>
        <label for="min_buyers">Minimum buyers</label>
        <input type="number" id="min_buyers" name="min_buyers" min="1" max="10000" step="1" value="<%= values.min_buyers %>">
        <p class="muted small">For products whose row doesn't set one.</p>
      </div>
    </div>
    <div class="row">
      <div>
        <label for="days">Deals run for (days)</label>
        <input type="number" id="days" name="days" min="1" max="30" step="1" value="<%= values.days %>">
        <p class="muted small">At most 30. For products whose row doesn't set it.</p>
      </div>
      <div>
        <label for="photos">Photos to copy per product</label>
        <input type="number" id="photos" name="photos" min="0" max="<%= maxPhotos %>" step="1" value="<%= values.photos %>">
        <p class="muted small">Copied from the other site onto your server after the import.</p>
      </div>
    </div>
    <label for="category">Category when it can't be worked out</label>
    <select id="category" name="category">
      <% for (const c of categories) { %><option value="<%= c.slug %>" <%= values.category === c.slug ? 'selected' : '' %>><%= c.emoji %> <%= c.name %></option><% } %>
    </select>
    <p><button type="submit" class="big">Show the preview</button></p>
  </form>
</section>
<% if (photoStats.photosQueued) { %>
<section class="card narrow import-status">
  <h2>Photo copying</h2>
  <p><%= photoStats.photosCopied %> of <%= photoStats.photosQueued %> photos copied<% if (photoStats.photosFailed) { %>, <%= photoStats.photosFailed %> could not be copied<% } %>.<% if (photoStats.busy) { %> Still working: <a href="/admin/import">refresh</a>.<% } %></p>
  <% if (photoStats.failures.length) { %>
  <details>
    <summary>Photos that weren't copied</summary>
    <ul class="small">
      <% for (const f of photoStats.failures) { %><li><a href="/admin/deals/<%= f.dealId %>">Deal <%= f.dealId %></a>: <%= f.reason %> <span class="muted break"><%= f.url %></span></li><% } %>
    </ul>
    <p class="small muted">Those deals show the photo from the other site instead, while it stays online. You can upload your own photos on the deal page.</p>
  </details>
  <% } %>
</section>
<% } %>
<%- include('../partials/footer') %>
