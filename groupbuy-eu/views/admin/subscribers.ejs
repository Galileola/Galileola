<%- include('../partials/header') %>
<p><a href="/admin/customers">← Customers</a></p>
<% if (flash) { %><div class="notice"><%= flash %></div><% } %>
<div class="perf-head">
  <h1>🔔 Deal alert subscribers</h1>
  <p class="row-buttons"><a class="button secondary" href="/admin/subscribers.csv">Download list (CSV)</a></p>
</div>
<p><strong><%= counts.confirmed || 0 %></strong> confirmed · <%= counts.pending || 0 %> waiting for confirmation · <%= counts.unsubscribed || 0 %> unsubscribed</p>
<p class="muted small">People sign up on the home page and confirm with the link in the first email (unconfirmed sign-ups are deleted after 30 days). To email a deal to everyone confirmed, use "Email to subscribers" on the deal's page. Every alert has an unsubscribe link.</p>
<div class="table-scroll">
<table>
  <thead><tr><th>Email</th><th>Language</th><th>Status</th><th>Signed up</th><th>Confirmed</th><th></th></tr></thead>
  <tbody>
  <% for (const s of subscribers) { %>
    <tr>
      <td><%= s.email %></td>
      <td><%= s.lang %></td>
      <td><span class="badge <%= s.status === 'confirmed' ? 'paid' : s.status === 'unsubscribed' ? 'released' : 'saved' %>"><%= s.status %></span></td>
      <td class="small"><%= formatDate(s.created_at) %></td>
      <td class="small"><%= formatDate(s.confirmed_at) %></td>
      <td>
        <form method="post" action="/admin/subscribers/<%= s.id %>/delete" data-confirm="Remove <%= s.email %> from the list?">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button type="submit" class="small secondary">Remove</button>
        </form>
      </td>
    </tr>
  <% } %>
  <% if (!subscribers.length) { %><tr><td colspan="6" class="muted">Nobody has signed up yet. The sign-up box is under the deals on the home page.</td></tr><% } %>
  </tbody>
</table>
</div>
<script src="/static/js/admin.js"></script>
<%- include('../partials/footer') %>
