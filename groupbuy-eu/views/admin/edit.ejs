<%- include('../partials/header') %>
<p><a href="/admin/deals/<%= deal.id %>">← Back to the deal</a></p>
<section class="card narrow">
  <h1>Edit deal</h1>
  <% if (Object.keys(errors).length) { %><div class="notice bad">Please check the fields marked below.</div><% } %>
  <form method="post" action="/admin/deals/<%= deal.id %>/edit" id="deal-form" novalidate>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <input type="hidden" name="deadline_iso" id="deadline_iso">

    <label for="product_name">Product</label>
    <input type="text" id="product_name" name="product_name" maxlength="120" required value="<%= values.product_name || '' %>">
    <% if (errors.product_name) { %><p class="error-text"><%= errors.product_name %></p><% } %>

    <div class="row">
      <div>
        <label for="category">Category</label>
        <select id="category" name="category">
          <% for (const c of categories) { %><option value="<%= c.slug %>" <%= values.category === c.slug ? 'selected' : '' %>><%= c.emoji %> <%= c.name %></option><% } %>
        </select>
        <% if (errors.category) { %><p class="error-text"><%= errors.category %></p><% } %>
      </div>
      <div>
        <label for="headline">Headline (optional)</label>
        <input type="text" id="headline" name="headline" maxlength="120" value="<%= values.headline || '' %>">
        <% if (errors.headline) { %><p class="error-text"><%= errors.headline %></p><% } %>
      </div>
    </div>

    <label for="description">Description</label>
    <textarea id="description" name="description" maxlength="5000" rows="8"><%= values.description || '' %></textarea>
    <p class="muted small">Leave a blank line between paragraphs. Edited texts are translated into the other languages again.</p>
    <% if (errors.description) { %><p class="error-text"><%= errors.description %></p><% } %>

    <label for="social_post">Social media post (admin only)</label>
    <textarea id="social_post" name="social_post" maxlength="2000" rows="4"><%= values.social_post || '' %></textarea>
    <% if (errors.social_post) { %><p class="error-text"><%= errors.social_post %></p><% } %>

    <% if (locked) { %>
      <div class="notice warn small">
        <% if (!open) { %>This deal is <%= deal.status.replace(/_/g, ' ') %>, so its price, minimum and deadline can't change any more.
        <% } else { %><%= joined %> buyer<%= joined === 1 ? ' has' : 's have' %> joined at this price and minimum, so those stay as they are. The deadline can only move later.<% } %>
      </div>
    <% } %>
    <div class="row">
      <div>
        <label for="price">Price in EUR, VAT included</label>
        <input type="text" id="price" name="price" inputmode="decimal" required value="<%= values.price || '' %>" <%= locked ? 'disabled' : '' %>>
        <% if (errors.price) { %><p class="error-text"><%= errors.price %></p><% } %>
      </div>
      <div>
        <label for="min_buyers">Minimum buyers</label>
        <input type="number" id="min_buyers" name="min_buyers" min="1" max="10000" step="1" required value="<%= values.min_buyers || '' %>" <%= locked ? 'disabled' : '' %>>
        <% if (errors.min_buyers) { %><p class="error-text"><%= errors.min_buyers %></p><% } %>
      </div>
    </div>

    <label for="deadline">Deadline (your local time, at most 30 days from now)</label>
    <input type="datetime-local" id="deadline" name="deadline" required data-iso="<%= values.deadline_iso || deal.deadline %>" <%= open && joined > 0 ? `data-min-iso="${deal.deadline}"` : '' %> <%= open ? '' : 'disabled' %>>
    <% if (errors.deadline) { %><p class="error-text"><%= errors.deadline %></p><% } %>

    <label for="tax_code">Stripe Tax product code</label>
    <input type="text" id="tax_code" name="tax_code" value="<%= values.tax_code || '' %>" <%= locked ? 'disabled' : '' %>>
    <% if (errors.tax_code) { %><p class="error-text"><%= errors.tax_code %></p><% } %>

    <details class="small">
      <summary>Image URL (used only when the deal has no photos)</summary>
      <label for="image_url">Image URL (https)</label>
      <input type="url" id="image_url" name="image_url" value="<%= values.image_url || '' %>">
    </details>
    <% if (errors.image_url) { %><p class="error-text"><%= errors.image_url %></p><% } %>

    <%- include('seo-fields') %>

    <p><button type="submit">Save changes</button> <a class="button secondary" href="/admin/deals/<%= deal.id %>">Cancel</a></p>
  </form>
</section>
<script src="<%= asset('/static/js/admin.js') %>"></script>
<%- include('../partials/footer') %>
