<%- include('../partials/header') %>
<p><a href="/admin">← Admin</a></p>
<section class="card narrow">
  <% if (done) { %>
    <div class="celebrate">
      <p class="celebrate-emoji" aria-hidden="true">🔐</p>
      <p class="celebrate-title">Password changed</p>
      <p>From now on, log in with your new password; the old one no longer works. You stay logged in here, and every other device where the admin was open has been logged out.</p>
    </div>
    <p><a class="button" href="/admin">Back to the admin</a></p>
  <% } else { %>
    <h1>🔑 Change password</h1>
    <p class="muted">Your new password goes straight from this page to your shop over a secure connection. Only a scrambled form of it (a hash) is stored, so nobody can read it back, not even from the database.</p>
    <% if (error) { %><div class="notice bad" role="alert"><%= error %></div><% } %>
    <form method="post" action="/admin/password" autocomplete="on">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input type="text" name="username" value="<%= locals.adminUser || 'admin' %>" autocomplete="username" hidden>
      <label for="current_password">Current password</label>
      <input type="password" id="current_password" name="current_password" autocomplete="current-password" required>
      <label for="new_password">New password</label>
      <input type="password" id="new_password" name="new_password" autocomplete="new-password" minlength="<%= minLength %>" maxlength="200" required>
      <p class="muted small">At least <%= minLength %> characters. Tip: let your browser or password manager suggest a strong one and save it.</p>
      <label for="repeat_password">New password again</label>
      <input type="password" id="repeat_password" name="repeat_password" autocomplete="new-password" minlength="<%= minLength %>" maxlength="200" required>
      <p><button type="submit">Change password</button></p>
    </form>
    <p class="muted small">Forgot it later? Set a new <code>ADMIN_PASSWORD</code> in Hostinger (Websites → your shop's website → Environment variables); that one then replaces the password changed here.</p>
  <% } %>
</section>
<%- include('../partials/footer') %>
