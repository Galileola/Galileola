<%- include('../partials/header') %>
<p><a href="/admin">← Admin</a> · <a href="/admin/emails">Email outbox</a></p>
<% if (justPublished) { %>
  <div class="celebrate live" data-confetti-on-load>
    <p class="celebrate-emoji" aria-hidden="true">🚀</p>
    <p class="celebrate-title">Your deal is live!</p>
    <p>It's in the deal list now. Share it below to get the first buyers in.</p>
    <p><a class="button" href="/deals/<%= deal.slug %>">See the public page</a> <a class="button secondary" href="/admin/snap">📸 Snap another</a></p>
  </div>
<% } %>
<% if (flash) { %><div class="notice"><%= flash %></div><% } %>
<h1><%= deal.product_name %> <span class="badge <%= deal.status %>"><%= deal.status.replace(/_/g, ' ') %></span></h1>
<p>Public page: <a href="/deals/<%= deal.slug %>">/deals/<%= deal.slug %></a></p>
<p class="row-buttons"><a class="button" href="/admin/deals/<%= deal.id %>/edit">✏️ Edit deal</a> <a class="button secondary" href="/admin/deals/new?copy=<%= deal.id %>">⧉ Duplicate</a></p>
<% if (deal.headline) { %><p class="deal-headline"><%= deal.headline %></p><% } %>

<div class="grid">
  <div class="card">
    <h2>Deal</h2>
    <p><%= formatEuro(deal.price_cents) %> incl. VAT · tax code <code><%= deal.tax_code %></code></p>
    <form method="post" action="/admin/deals/<%= deal.id %>/category" class="inline-form">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <label for="category" class="inline-label">Category</label>
      <select id="category" name="category">
        <% for (const c of categories) { %><option value="<%= c.slug %>" <%= deal.category === c.slug ? 'selected' : '' %>><%= c.emoji %> <%= c.name %></option><% } %>
      </select>
      <button type="submit" class="small secondary">Save</button>
    </form>
    <p>Buyers: <strong><%= committed %></strong> of <%= deal.min_buyers %> minimum</p>
    <p>Deadline: <%= formatDate(deal.deadline) %></p>
    <% if (deal.minimum_reached_at) { %><p>Minimum reached: <%= formatDate(deal.minimum_reached_at) %></p><% } %>
    <% if (deal.grace_ends_at) { %><p>48-hour payment window ends: <%= formatDate(deal.grace_ends_at) %></p><% } %>
    <% if (deal.ready_at) { %><p>Ready to order since: <%= formatDate(deal.ready_at) %></p><% } %>
    <% if (deal.expired_at) { %><p>Expired: <%= formatDate(deal.expired_at) %> (nobody charged)</p><% } %>
  </div>
  <div class="card">
    <h2>Money</h2>
    <p>Paid: <strong><%= summary.paidCount %></strong> · <%= formatEuro(summary.paidCents) %></p>
    <p>SEPA processing (counted as paid): <%= summary.processingCount %> · <%= formatEuro(summary.processingCents) %></p>
    <p>Failed, inside 48h window: <%= summary.openFailures %> · <%= formatEuro(summary.openFailuresCents) %></p>
    <p>Unpaid, your cost: <strong><%= summary.yourCostCount %></strong> · <%= formatEuro(summary.yourCostCents) %></p>
    <p class="muted small">VAT in collected amounts: <%= formatEuro(summary.vatCents) %></p>
    <% if (deal.status === 'ready_to_order') { %>
      <div class="notice ok">Order quantity: <strong><%= summary.orderQuantity %></strong> paid units (including SEPA debits still processing).</div>
    <% } %>
    <% if (summary.orderQuantity > 0) { %>
      <p><a class="button secondary" href="/admin/deals/<%= deal.id %>/orders.csv">Download order list (CSV)</a></p>
    <% } %>
  </div>
</div>

<% if (['open', 'charging', 'ready_to_order'].includes(deal.status)) { %>
<% const post = (deal.social_post || ('🛍️ ' + (deal.headline || deal.product_name) + '\nJoin the group deal: when enough of us join, we all get it for ' + formatEuro(deal.price_cents) + '.')) + '\n\n' + dealUrl; %>
<section class="card share-kit" style="margin-top:16px">
  <h2>📣 Share kit</h2>
  <p class="muted small">A ready-made post for Instagram, Facebook or WhatsApp, with the deal link. Edit it here before you copy it; changes aren't saved.</p>
  <textarea class="social-post" id="social-post" rows="6" aria-label="Social media post"><%= post %></textarea>
  <p><button type="button" class="small" data-copy-from="social-post">📋 Copy post</button></p>
  <%- include('../partials/share', { shareUrl: dealUrl, shareText: deal.headline || deal.product_name, shareMedium: 'social' }) %>
</section>
<% } %>

<section class="card" id="photos" style="margin-top:16px">
  <h2>Photos</h2>
  <p class="muted small">The first photo is the cover on the deal list. Up to <%= maxPhotos %> photos, JPG, PNG, WebP or GIF, max 8 MB each.</p>
  <% if (photos.length) { %>
    <div class="photo-grid">
      <% photos.forEach((ph, i) => { %>
        <figure class="photo-item">
          <img src="<%= photoUrl(ph.filename) %>" alt="Photo <%= i + 1 %>" loading="lazy">
          <figcaption>
            <% if (i === 0) { %>
              <span class="badge paid">Cover</span>
            <% } else { %>
              <form method="post" action="/admin/photos/<%= ph.id %>/cover">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button type="submit" class="small secondary">Make cover</button>
              </form>
            <% } %>
            <form method="post" action="/admin/photos/<%= ph.id %>/delete" data-confirm="Delete this photo? This can't be undone.">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button type="submit" class="small danger">Delete</button>
            </form>
          </figcaption>
        </figure>
      <% }) %>
    </div>
  <% } else { %>
    <p class="muted">No photos yet<%= deal.image_url ? ' (the deal uses its image URL)' : '' %>.</p>
  <% } %>
  <% if (photos.length < maxPhotos) { %>
    <form method="post" action="/admin/deals/<%= deal.id %>/photos" enctype="multipart/form-data" class="upload-form">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input type="file" name="photos" multiple accept="<%= photoAccept %>" class="file-input" aria-label="Choose photos">
      <button type="submit">Upload photos</button>
    </form>
  <% } %>
</section>

<h2 style="margin-top:24px">Buyers</h2>
<div class="table-scroll">
<table>
  <thead><tr><th>#</th><th>Buyer</th><th>Country</th><th>Method</th><th>Amount / VAT</th><th>Status</th><th>Attempts / last error</th><th>Window ends</th><th></th></tr></thead>
  <tbody>
  <% for (const p of participants) { %>
    <tr>
      <td><%= p.id %></td>
      <td><%= p.name %><br><span class="muted small"><%= p.email %></span></td>
      <td><%= p.country %></td>
      <td><%= p.payment_method_label || '—' %></td>
      <td><%= p.amount_cents != null ? formatEuro(p.amount_cents) : '—' %><br><span class="muted small"><%= p.tax_cents != null ? 'VAT ' + formatEuro(p.tax_cents) + (p.tax_rate_label ? ' (' + p.tax_rate_label + ')' : '') : '' %></span></td>
      <td><span class="badge <%= p.status %>"><%= p.status.replace(/_/g, ' ') %></span><% if (p.needs_authentication) { %><br><span class="small">needs SCA</span><% } %></td>
      <td><%= p.attempts %><% if (p.last_error_code || p.last_error_message) { %><br><span class="small error-text"><%= p.last_error_code || '' %> <%= p.last_error_message || '' %></span><% } %></td>
      <td class="small"><%= formatDate(p.grace_ends_at) %><% if (p.next_retry_at && p.status === 'failed') { %><br>retry <%= formatDate(p.next_retry_at) %><% } %></td>
      <td><%- include('participant-actions', { p }) %></td>
    </tr>
  <% } %>
  <% if (!participants.length) { %><tr><td colspan="9" class="muted">No buyers yet.</td></tr><% } %>
  </tbody>
</table>
</div>

<% const canCancel = deal.status === 'open' && committed < deal.min_buyers; const canDelete = participantTotal === 0; %>
<% if (canCancel || canDelete) { %>
<section class="card danger-zone" style="margin-top:16px">
  <h2>Cancel or delete</h2>
  <% if (canCancel) { %>
    <form method="post" action="/admin/deals/<%= deal.id %>/cancel" data-confirm="Cancel this deal now? It closes for everyone, nobody is charged, saved payment methods are removed and <%= committed %> buyer(s) get an email. This can't be undone.">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <p><button type="submit" class="danger">Cancel deal</button> <span class="muted small">Closes it now. Nobody is charged<%= committed ? ` and the ${committed} buyer${committed === 1 ? '' : 's'} get an email` : '' %>.</span></p>
    </form>
  <% } %>
  <% if (canDelete) { %>
    <form method="post" action="/admin/deals/<%= deal.id %>/delete" data-confirm="Delete this deal and its photos for good? This can't be undone.">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <p><button type="submit" class="danger">Delete deal</button> <span class="muted small">Nobody has joined it, so it can be removed completely, with its photos.</span></p>
    </form>
  <% } %>
</section>
<% } %>

<% if (testTools) { %><%- include('deal-tools') %><% } %>
<script src="/static/js/admin.js"></script>
<%- include('../partials/footer') %>
