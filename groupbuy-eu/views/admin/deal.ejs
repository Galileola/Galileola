<%- include('../partials/header') %>
<p><a href="/admin">← Admin</a> · <a href="/admin/emails">Email outbox</a></p>
<% if (justPublished) { %>
  <div class="celebrate live" data-confetti-on-load>
    <p class="celebrate-emoji" aria-hidden="true">🚀</p>
    <p class="celebrate-title">Your deal is live!</p>
    <p>It's in the deal list now. Share it below to get the first buyers in.</p>
    <p><a class="button" href="/deals/<%= deal.slug %>">See the public page</a> <a class="button secondary" href="/admin/snap">📸 Snap another</a></p>
  </div>
<% } %>
<% if (flash) { %><div class="notice"><%= flash %></div><% } %>
<h1><%= deal.product_name %> <span class="badge <%= deal.status %>"><%= deal.status.replace(/_/g, ' ') %></span></h1>
<p>Public page: <a href="/deals/<%= deal.slug %>">/deals/<%= deal.slug %></a></p>
<p class="row-buttons"><a class="button" href="/admin/deals/<%= deal.id %>/edit">✏️ Edit deal</a> <a class="button secondary" href="/admin/deals/new?copy=<%= deal.id %>">⧉ Duplicate</a></p>
<% if (deal.headline) { %><p class="deal-headline"><%= deal.headline %></p><% } %>

<div class="grid">
  <div class="card">
    <h2>Deal</h2>
    <p><%= formatEuro(deal.price_cents) %> incl. VAT · tax code <code><%= deal.tax_code %></code></p>
    <form method="post" action="/admin/deals/<%= deal.id %>/category" class="inline-form">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <label for="category" class="inline-label">Category</label>
      <select id="category" name="category">
        <% for (const c of categories) { %><option value="<%= c.slug %>" <%= deal.category === c.slug ? 'selected' : '' %>><%= c.emoji %> <%= c.name %></option><% } %>
      </select>
      <button type="submit" class="small secondary">Save</button>
    </form>
    <p>Buyers: <strong><%= committed %></strong> of <%= deal.min_buyers %> minimum</p>
    <p>Deadline: <%= formatDate(deal.deadline) %></p>
    <% if (deal.minimum_reached_at) { %><p>Minimum reached: <%= formatDate(deal.minimum_reached_at) %></p><% } %>
    <% if (deal.grace_ends_at) { %><p>48-hour payment window ends: <%= formatDate(deal.grace_ends_at) %></p><% } %>
    <% if (deal.ready_at) { %><p>Ready to order since: <%= formatDate(deal.ready_at) %></p><% } %>
    <% if (deal.expired_at) { %><p>Expired: <%= formatDate(deal.expired_at) %> (nobody charged)</p><% } %>
  </div>
  <div class="card">
    <h2>Money</h2>
    <p>Paid: <strong><%= summary.paidCount %></strong> · <%= formatEuro(summary.paidCents) %></p>
    <p>SEPA processing (counted as paid): <%= summary.processingCount %> · <%= formatEuro(summary.processingCents) %></p>
    <p>Failed, inside 48h window: <%= summary.openFailures %> · <%= formatEuro(summary.openFailuresCents) %></p>
    <p>Unpaid, your cost: <strong><%= summary.yourCostCount %></strong> · <%= formatEuro(summary.yourCostCents) %></p>
    <p class="muted small">VAT in collected amounts: <%= formatEuro(summary.vatCents) %></p>
    <% if (deal.status === 'ready_to_order') { %>
      <div class="notice ok">Order quantity: <strong><%= summary.orderQuantity %></strong> paid units (including SEPA debits still processing).</div>
    <% } %>
    <% if (summary.orderQuantity > 0) { %>
      <p><a class="button secondary" href="/admin/deals/<%= deal.id %>/orders.csv">Download order list (CSV)</a></p>
    <% } %>
  </div>
</div>

<% if (['open', 'charging', 'ready_to_order'].includes(deal.status)) { %>
<% const post = (deal.social_post || ('🛍️ ' + (deal.headline || deal.product_name) + '\nJoin the group deal: when enough of us join, we all get it for ' + formatEuro(deal.price_cents) + '.')) + '\n\n' + dealUrl; %>
<section class="card share-kit" style="margin-top:16px">
  <h2>📣 Share kit</h2>
  <p class="muted small">A ready-made post for Instagram, Facebook or WhatsApp, with the deal link. Edit it here before you copy it; changes aren't saved.</p>
  <textarea class="social-post" id="social-post" rows="6" aria-label="Social media post"><%= post %></textarea>
  <p><button type="button" class="small" data-copy-from="social-post">📋 Copy post</button></p>
  <%- include('../partials/share', { shareUrl: dealUrl, shareText: deal.headline || deal.product_name, shareMedium: 'social' }) %>
</section>
<% } %>

<% if (deal.status === 'open') { %>
<section class="card announce" style="margin-top:16px">
  <h2>🔔 Email to deal-alert subscribers</h2>
  <% if (deal.announced_at) { %><p class="small">Sent on <%= formatDate(deal.announced_at) %>.</p><% } %>
  <% if (alertSubscribers) { %>
    <form method="post" action="/admin/deals/<%= deal.id %>/announce" data-confirm="<%= deal.announced_at ? 'This deal was already emailed. Send it again to' : 'Email this deal to' %> <%= alertSubscribers %> subscriber(s)?">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <p><button type="submit"<%- deal.announced_at ? ' class="secondary"' : '' %>>Email it to <%= alertSubscribers %> subscriber<%= alertSubscribers === 1 ? '' : 's' %></button> <span class="muted small">In each subscriber's language, with an unsubscribe link.</span></p>
    </form>
  <% } else { %>
    <p class="muted small">Nobody has confirmed a deal-alert sign-up yet. Shoppers sign up under the deals on the home page; <a href="/admin/subscribers">see the list</a>.</p>
  <% } %>
</section>
<% } %>

<section class="card" id="photos" style="margin-top:16px">
  <h2>Photos</h2>
  <p class="muted small">The first photo is the cover on the deal list. Use the arrows to change the order. Up to <%= maxPhotos %> photos, JPG, PNG, WebP or GIF, max 8 MB each. Photos are resized for fast pages and their location data is removed.</p>
  <% if (photos.length) { %>
    <div class="photo-grid">
      <% photos.forEach((ph, i) => { %>
        <figure class="photo-item">
          <img src="<%= thumbUrl(ph) %>" alt="<%= ph.alt || `Photo ${i + 1}` %>" loading="lazy">
          <figcaption>
            <div class="photo-actions">
              <% if (i === 0) { %>
                <span class="badge paid">Cover</span>
              <% } else { %>
                <form method="post" action="/admin/photos/<%= ph.id %>/cover">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <button type="submit" class="small secondary">Make cover</button>
                </form>
              <% } %>
              <form method="post" action="/admin/photos/<%= ph.id %>/move" class="photo-move">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button type="submit" name="dir" value="earlier" class="small secondary" aria-label="Move photo <%= i + 1 %> earlier" <%= i === 0 ? 'disabled' : '' %>>◀</button>
                <button type="submit" name="dir" value="later" class="small secondary" aria-label="Move photo <%= i + 1 %> later" <%= i === photos.length - 1 ? 'disabled' : '' %>>▶</button>
              </form>
              <form method="post" action="/admin/photos/<%= ph.id %>/delete" data-confirm="Delete this photo? This can't be undone.">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button type="submit" class="small danger">Delete</button>
              </form>
            </div>
            <form method="post" action="/admin/photos/<%= ph.id %>/alt" class="photo-alt">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <label class="visually-hidden" for="alt-<%= ph.id %>">Description of photo <%= i + 1 %></label>
              <input type="text" id="alt-<%= ph.id %>" name="alt" maxlength="200" value="<%= ph.alt %>" placeholder="Describe the photo (optional)">
              <button type="submit" class="small secondary">Save</button>
            </form>
          </figcaption>
        </figure>
      <% }) %>
    </div>
  <% } else { %>
    <p class="muted">No photos yet<%= deal.image_url ? ' (the deal uses its image URL)' : '' %>.</p>
  <% } %>
  <% if (photos.length < maxPhotos) { %>
    <form method="post" action="/admin/deals/<%= deal.id %>/photos" enctype="multipart/form-data" class="upload-form">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input type="file" name="photos" multiple accept="<%= photoAccept %>" class="file-input" aria-label="Choose photos">
      <button type="submit">Upload photos</button>
    </form>
  <% } %>
</section>

<% const orders = participants.filter((p) => ['paid', 'processing'].includes(p.status)); const unshipped = orders.filter((p) => !p.shipped_at); const active = participants.filter((p) => ['saved', 'charging', 'paid', 'processing', 'failed'].includes(p.status)); %>
<% if (orders.length) { %>
<section class="card" id="shipping" style="margin-top:16px">
  <h2>📦 Shipping</h2>
  <p><strong><%= orders.length - unshipped.length %></strong> of <%= orders.length %> paid order<%= orders.length === 1 ? "" : "s" %> shipped.</p>
  <p class="muted small">When you mark an order as shipped, the buyer gets an email in their language with the tracking number and link, if you add them. Mark one order in the buyer table below, or many at once here.</p>
  <% if (unshipped.length) { %>
    <details>
      <summary>Paste tracking numbers for many orders</summary>
      <form method="post" action="/admin/deals/<%= deal.id %>/ship-bulk">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <label for="lines">One order per line: order number, tracking number, tracking link (the link is optional)</label>
        <textarea id="lines" name="lines" rows="5" placeholder="<%= unshipped.slice(0, 2).map((p) => `${p.id}, JJD000390007${p.id}, https://tracking.example.com/JJD000390007${p.id}`).join(String.fromCharCode(10)) %>"></textarea>
        <p class="muted small">The order number is the # column below (participant_id in the order list). You can paste columns straight from a spreadsheet.</p>
        <p><button type="submit">Mark these as shipped</button></p>
      </form>
    </details>
    <form method="post" action="/admin/deals/<%= deal.id %>/ship-bulk" data-confirm="Mark all <%= unshipped.length %> unshipped paid orders as shipped, without tracking numbers, and email the buyers?">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input type="hidden" name="all" value="1">
      <p><button type="submit" class="secondary">Mark all <%= unshipped.length %> as shipped (no tracking)</button></p>
    </form>
  <% } %>
</section>
<% } %>

<% if (active.length) { %>
<section class="card" id="message" style="margin-top:16px">
  <h2>✉️ Message the buyers</h2>
  <p class="muted small">For news about the deal: a delivery date, a delay, pick-up details. Each buyer gets their own email with a greeting and your shop's details.<% if (locals.aiWritingEnabled) { %> It is translated into each buyer's language by the AI; if that fails, they get your text as written.<% } else { %> It is sent as you write it; buyers chose their own language on the site, so keep it simple or write it in English.<% } %></p>
  <form method="post" action="/admin/deals/<%= deal.id %>/message" data-confirm="Send this email now?">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <label for="msg-audience">Send to</label>
    <select id="msg-audience" name="audience">
      <option value="all">Everyone in the deal (<%= active.length %>)</option>
      <% if (orders.length) { %><option value="paid">Only paid orders (<%= orders.length %>)</option><% } %>
    </select>
    <label for="msg-subject">Subject</label>
    <input type="text" id="msg-subject" name="subject" maxlength="150" required>
    <label for="msg-body">Message</label>
    <textarea id="msg-body" name="body" rows="6" maxlength="5000" required></textarea>
    <p><button type="submit">Send</button></p>
  </form>
</section>
<% } %>

<h2 style="margin-top:24px" id="buyers">Buyers</h2>
<div class="table-scroll">
<table>
  <thead><tr><th>#</th><th>Buyer</th><th>Country</th><th>Method</th><th>Amount / VAT</th><th>Status</th><th>Attempts / last error</th><th>Window ends</th><th>Shipping</th><th><span class="visually-hidden">Actions</span></th></tr></thead>
  <tbody>
  <% for (const p of participants) { %>
    <tr>
      <td><%= p.id %></td>
      <td><%= p.name %><br><span class="muted small"><%= p.email %></span></td>
      <td><%= p.country %></td>
      <td><%= p.payment_method_label || '—' %></td>
      <td><%= p.amount_cents != null ? formatEuro(p.amount_cents) : '—' %><br><span class="muted small"><%= p.tax_cents != null ? 'VAT ' + formatEuro(p.tax_cents) + (p.tax_rate_label ? ' (' + p.tax_rate_label + ')' : '') : '' %></span></td>
      <td><span class="badge <%= p.status %>"><%= p.status.replace(/_/g, ' ') %></span><% if (p.needs_authentication) { %><br><span class="small">needs SCA</span><% } %></td>
      <td><%= p.attempts %><% if (p.last_error_code || p.last_error_message) { %><br><span class="small error-text"><%= p.last_error_code || '' %> <%= p.last_error_message || '' %></span><% } %></td>
      <td class="small"><%= formatDate(p.grace_ends_at) %><% if (p.next_retry_at && p.status === 'failed') { %><br>retry <%= formatDate(p.next_retry_at) %><% } %></td>
      <td class="small ship-cell">
        <% if (p.shipped_at) { %>
          <span class="badge paid">shipped</span> <%= formatDate(p.shipped_at) %>
          <% if (p.tracking_number || p.tracking_url) { %><br><% if (p.tracking_url) { %><a href="<%= p.tracking_url %>" rel="noopener noreferrer" target="_blank"><%= p.tracking_number || 'Tracking' %></a><% } else { %><%= p.tracking_number %><% } %><% } %>
          <form method="post" action="/admin/participants/<%= p.id %>/unship" data-confirm="Undo 'shipped' for order #<%= p.id %>? No email is sent.">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button type="submit" class="linklike small">undo</button>
          </form>
        <% } else if (['paid', 'processing'].includes(p.status)) { %>
          <details>
            <summary>Mark shipped</summary>
            <form method="post" action="/admin/participants/<%= p.id %>/ship" class="ship-form">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <input type="text" name="tracking" maxlength="100" placeholder="Tracking number" aria-label="Tracking number for order #<%= p.id %>">
              <input type="text" name="url" maxlength="500" placeholder="Tracking link (optional)" aria-label="Tracking link for order #<%= p.id %>">
              <button type="submit" class="small">Shipped</button>
            </form>
          </details>
        <% } else { %>—<% } %>
      </td>
      <td><%- include('participant-actions', { p }) %></td>
    </tr>
  <% } %>
  <% if (!participants.length) { %><tr><td colspan="10" class="muted">No buyers yet.</td></tr><% } %>
  </tbody>
</table>
</div>

<% const canCancel = deal.status === 'open' && committed < deal.min_buyers; const canDelete = participantTotal === 0; %>
<% if (canCancel || canDelete) { %>
<section class="card danger-zone" style="margin-top:16px">
  <h2>Cancel or delete</h2>
  <% if (canCancel) { %>
    <form method="post" action="/admin/deals/<%= deal.id %>/cancel" data-confirm="Cancel this deal now? It closes for everyone, nobody is charged, saved payment methods are removed and <%= committed %> buyer(s) get an email. This can't be undone.">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <p><button type="submit" class="danger">Cancel deal</button> <span class="muted small">Closes it now. Nobody is charged<%= committed ? ` and the ${committed} buyer${committed === 1 ? '' : 's'} get an email` : '' %>.</span></p>
    </form>
  <% } %>
  <% if (canDelete) { %>
    <form method="post" action="/admin/deals/<%= deal.id %>/delete" data-confirm="Delete this deal and its photos for good? This can't be undone.">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <p><button type="submit" class="danger">Delete deal</button> <span class="muted small">Nobody has joined it, so it can be removed completely, with its photos.</span></p>
    </form>
  <% } %>
</section>
<% } %>

<% if (testTools) { %><%- include('deal-tools') %><% } %>
<script src="<%= asset('/static/js/admin.js') %>"></script>
<%- include('../partials/footer') %>
