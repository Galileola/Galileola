<%- include('../partials/header') %>
<p><a href="/admin">← Admin</a></p>
<section class="card narrow">
  <h1>New deal</h1>
  <form method="post" action="/admin/deals" id="deal-form" enctype="multipart/form-data" novalidate>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <input type="hidden" name="deadline_iso" id="deadline_iso">

    <label for="product_name">Product</label>
    <input type="text" id="product_name" name="product_name" maxlength="120" required value="<%= values.product_name || '' %>">
    <% if (errors.product_name) { %><p class="error-text"><%= errors.product_name %></p><% } %>

    <label for="description">Description</label>
    <textarea id="description" name="description" maxlength="5000"><%= values.description || '' %></textarea>
    <% if (errors.description) { %><p class="error-text"><%= errors.description %></p><% } %>


    <div class="row">
      <div>
        <label for="price">Price in EUR, VAT included</label>
        <input type="text" id="price" name="price" inputmode="decimal" placeholder="49.00" required value="<%= values.price || '' %>">
        <% if (errors.price) { %><p class="error-text"><%= errors.price %></p><% } %>
      </div>
      <div>
        <label for="min_buyers">Minimum buyers</label>
        <input type="number" id="min_buyers" name="min_buyers" min="1" max="10000" step="1" required value="<%= values.min_buyers || '' %>">
        <% if (errors.min_buyers) { %><p class="error-text"><%= errors.min_buyers %></p><% } %>
      </div>
    </div>

    <label for="deadline">Deadline (your local time, at most 30 days from now)</label>
    <input type="datetime-local" id="deadline" name="deadline" required value="<%= values.deadline || '' %>">
    <% if (errors.deadline) { %><p class="error-text"><%= errors.deadline %></p><% } %>

    <label for="tax_code">Stripe Tax product code</label>
    <input type="text" id="tax_code" name="tax_code" value="<%= values.tax_code || '' %>">
    <p class="muted small">Default txcd_99999999 is "General – Tangible Goods". VAT is worked out per buyer country by Stripe Tax; the gross price stays the same for everyone.</p>
    <% if (errors.tax_code) { %><p class="error-text"><%= errors.tax_code %></p><% } %>

    <%# Photos stay the last field: the upload is read in form order, so the other fields are
        already read if a photo is too large. %>
    <label for="photos">Product photos (optional)</label>
    <input type="file" id="photos" name="photos" multiple accept="<%= photoAccept %>" class="file-input">
    <p class="muted small">Up to <%= maxPhotos %> photos, JPG, PNG, WebP or GIF, max 8 MB each. The first one is the cover. You can add or change photos later.</p>
    <% if (errors.photos) { %><p class="error-text"><%= errors.photos %></p><% } %>

    <details class="small">
      <summary>Or use a photo that's already online</summary>
      <label for="image_url">Image URL (https)</label>
      <input type="url" id="image_url" name="image_url" value="<%= values.image_url || '' %>">
      <p class="muted small">Only used when the deal has no uploaded photos.</p>
    </details>
    <% if (errors.image_url) { %><p class="error-text"><%= errors.image_url %></p><% } %>

    <p><button type="submit">Create deal</button></p>
  </form>
</section>
<script src="/static/js/admin.js"></script>
<%- include('../partials/footer') %>
