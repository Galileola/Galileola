<%- include('../partials/header') %>
<a class="snap-cta" href="/admin/snap">
  <span class="snap-cta-lens" aria-hidden="true">📸</span>
  <span><strong>Snap a deal</strong><span>Seen a great product? Take a photo. The AI writes the ad, you add the price, and it's live.</span></span>
</a>
<% if (locals.flash) { %><div class="notice"><%= flash %></div><% } %>
<% if (locals.openWithdrawals) { %><div class="notice warn"><strong>↩️ <%= openWithdrawals %> withdrawal<%= openWithdrawals === 1 ? '' : 's' %> to handle.</strong> A paid order must be refunded within 14 days. <a href="/admin/withdrawals">Open Withdrawals</a></div><% } %>
<% if (locals.live && problems.length) { %>
  <div class="notice bad"><strong>Real payments are on, but the shop isn't taking new orders yet.</strong> Deal pages say "closed to new buyers" until these are done: <%= problems.map((p) => p.label).join(', ') %>. <a href="/admin/go-live">Open the go-live checklist</a>.</div>
<% } else if (locals.live) { %>
  <p class="mode-pill live">● Live: real payments</p>
<% } else if (locals.live === false) { %>
  <p class="mode-pill">● Test mode: no real payments. <a href="/admin/go-live">Go-live checklist</a></p>
<% } %>
<h1>Deals</h1>
<p class="admin-actions"><a class="button secondary" href="/admin/deals/new">New deal (full form)</a> <a class="button secondary" href="/admin/import">📥 Import products (CSV)</a> <a class="button secondary" href="/admin/backup.sqlite">Download database backup</a> <a class="button secondary" href="/admin/photos.zip">Download photos (ZIP)</a></p>
<div class="table-scroll">
<table>
  <thead><tr><th>Product</th><th>Category</th><th>Price</th><th>Buyers</th><th>Deadline</th><th>Status</th></tr></thead>
  <tbody>
  <% for (const d of deals) { %>
    <tr>
      <td>
        <div class="product-cell">
          <% if (d.cover) { %><img class="thumb-sm" src="<%= thumbUrl(d.cover) %>" alt=""><% } %>
          <a href="/admin/deals/<%= d.id %>"><%= d.product_name %></a><% if (d.kind === 'digital') { %> <span class="badge digital" title="Digital download, sold only in Estonia">⬇️ download</span><% } %>
        </div>
      </td>
      <td class="nowrap"><% const c = categoryFor(d.category); %><span aria-hidden="true"><%= c.emoji %></span> <%= c.name %></td>
      <td><%= formatEuro(d.price_cents) %></td>
      <td><%= d.count %> / <%= d.min_buyers %></td>
      <td><%= formatDate(d.deadline) %></td>
      <td><span class="badge <%= d.status %>"><%= d.status.replace(/_/g, ' ') %></span></td>
    </tr>
  <% } %>
  <% if (!deals.length) { %><tr><td colspan="6" class="muted">No deals yet. Tap <a href="/admin/snap">📸 Snap a deal</a> to add your first one.</td></tr><% } %>
  </tbody>
</table>
</div>
<%- include('../partials/footer') %>
