<%- include('partials/header') %>
<section class="card narrow stack">
  <h1><%= deal.product_name %></h1>
  <% const amount = formatEuro(p.amount_cents ?? deal.price_cents); const method = p.payment_method_label || ''; %>
  <% if (p.status === 'pending_setup') { %>
    <div class="notice warn"><%= t('done.pending') %></div>
    <p><a class="button secondary" href="/join/<%= p.token %>"><%= t('done.back') %></a></p>
  <% } else if (p.status === 'saved' && deal.status !== 'open') { %>
    <div class="notice ok"><%- th('done.reachedHtml', { amount, method }) %></div>
  <% } else if (p.status === 'saved') { %>
    <div class="celebrate" data-confetti-on-load>
      <p class="celebrate-emoji" aria-hidden="true">🎉</p>
      <p class="celebrate-title"><%= t('done.youreIn') %></p>
      <p class="muted"><%= t('done.nothingCharged') %></p>
    </div>
    <p><%- th('done.willChargeHtml', { amount, method, min: deal.min_buyers, date: formatDate(deal.deadline), vat: p.tax_cents != null ? t('done.vatParen', { amount: formatEuro(p.tax_cents) }) : '' }) %></p>
    <p><%- th('done.buyersSoFarHtml', { count: state.count, min: state.minBuyers }) %></p>
    <%- include('partials/share', { shareUrl: baseUrl + '/deals/' + deal.slug + '?lang=' + lang, shareText: t('done.shareMessage', { name: deal.product_name }) }) %>
  <% } else if (p.status === 'charging') { %>
    <div class="notice"><%= t('done.charging', { amount }) %></div>
  <% } else if (p.status === 'paid') { %>
    <div class="celebrate" data-confetti-on-load>
      <p class="celebrate-emoji" aria-hidden="true">🛍️</p>
      <p class="celebrate-title"><%= t('done.paidTitle') %></p>
      <p class="muted"><%= t('done.paidText', { amount }) %></p>
    </div>
  <% } else if (p.status === 'processing') { %>
    <div class="notice ok"><%- th('done.processingHtml', { amount }) %></div>
  <% } else if (p.status === 'failed') { %>
    <div class="notice bad"><%- th('done.failedHtml', { link: '/pay/' + p.token, date: formatDate(p.grace_ends_at) }) %></div>
  <% } else if (p.status === 'released') { %>
    <div class="notice"><%= t('done.released') %></div>
  <% } else if (p.status === 'unpaid' || p.status === 'late_failed') { %>
    <div class="notice"><%= t('done.unpaid') %></div>
  <% } else if (p.status === 'withdrawn') { %>
    <div class="notice"><%= p.refund_id ? t('done.withdrawnRefunded') : t('done.withdrawn') %></div>
  <% } %>
  <p><a href="/deals/<%= deal.slug %>"><%= t('done.backToDeal') %></a></p>
  <% if (!['withdrawn', 'released'].includes(p.status)) { %><p><a class="withdraw-link" href="/withdraw?order=<%= encodeURIComponent(p.token) %>"><%= t('withdraw.link') %></a></p><% } %>
</section>
<%- include('partials/footer') %>
