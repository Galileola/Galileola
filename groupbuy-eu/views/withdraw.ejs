<%- include('partials/header') %>
<%# The online withdrawal function (src/withdrawals.js, src/routes/withdraw.js). %>
<section class="card narrow stack">
  <% if (done) { const w = done.withdrawal; %>
    <p class="message-emoji" aria-hidden="true">📨</p>
    <h1><%= t('withdraw.doneTitle') %></h1>
    <div class="notice ok" role="status"><%= t('withdraw.doneReceived', { date: formatDate(w.created_at), email: w.email }) %></div>
    <p><strong><%= { cancelled: t('withdraw.doneCancelled'), refund: t('withdraw.doneRefund'), review: t('withdraw.doneReview'), ended: t('withdraw.doneEnded'), digital: t('withdraw.doneDigital') }[done.outcome] %></strong></p>
    <dl class="withdrawal-summary">
      <dt><%= t('withdraw.reference') %></dt><dd><code><%= w.reference %></code></dd>
      <dt><%= t('withdraw.order') %></dt><dd><%= w.order_text %></dd>
      <dt><%= t('withdraw.name') %></dt><dd><%= w.name %></dd>
      <dt><%= t('withdraw.email') %></dt><dd><%= w.email %></dd>
      <% if (w.message) { %><dt><%= t('withdraw.messageLabel') %></dt><dd><%= w.message %></dd><% } %>
    </dl>
  <% } else { %>
    <h1><%= t('withdraw.title') %></h1>
    <p><%= t('withdraw.intro') %></p>
    <form method="post" action="/withdraw" class="stack" novalidate>
      <input type="hidden" name="lang" value="<%= lang %>">
      <% if (errors.form) { %><div class="notice bad" role="alert"><%= errors.form %></div><% } %>
      <div>
        <label for="w-order"><%= t('withdraw.order') %></label>
        <% if (order) { %>
          <input type="hidden" name="order_token" value="<%= order.token %>">
          <p id="w-order" class="withdraw-order"><strong><%= order.label %></strong></p>
        <% } else { %>
          <input type="text" id="w-order" name="order" maxlength="<%= limits.order %>" required value="<%= values.order || '' %>" aria-describedby="w-order-hint">
          <p class="small muted" id="w-order-hint"><%= t('withdraw.orderHint') %></p>
          <% if (errors.order) { %><p class="error-text"><%= errors.order %></p><% } %>
        <% } %>
      </div>
      <div>
        <label for="w-name"><%= t('withdraw.name') %></label>
        <input type="text" id="w-name" name="name" autocomplete="name" maxlength="<%= limits.name %>" required value="<%= values.name || '' %>">
        <% if (errors.name) { %><p class="error-text"><%= errors.name %></p><% } %>
      </div>
      <div>
        <label for="w-email"><%= t('withdraw.email') %></label>
        <input type="email" id="w-email" name="email" autocomplete="email" maxlength="<%= limits.email %>" required value="<%= values.email || '' %>">
        <% if (errors.email) { %><p class="error-text"><%= errors.email %></p><% } %>
      </div>
      <div>
        <label for="w-message"><%= t('withdraw.message') %></label>
        <textarea id="w-message" name="message" rows="3" maxlength="<%= limits.message %>"><%= values.message || '' %></textarea>
      </div>
      <div class="hp" aria-hidden="true"><label for="w-website">Website</label><input type="text" id="w-website" name="website" tabindex="-1" autocomplete="off"></div>
      <p><button type="submit" class="big"><%= t('withdraw.confirm') %></button></p>
    </form>
  <% } %>
</section>
<%- include('partials/footer') %>
