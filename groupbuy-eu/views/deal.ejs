<%- include('partials/header') %>
<% const images = (locals.photos || []).map((p) => photoUrl(p.filename)); if (!images.length && deal.image_url) images.push(deal.image_url); %>
<div class="deal-layout" id="deal" data-slug="<%= deal.slug %>">
  <section class="deal-hero">
    <% if (images.length) { %>
      <div class="gallery">
        <img class="gallery-main" src="<%= images[0] %>" alt="<%= deal.product_name %>" data-gallery-main>
        <% if (images.length > 1) { %>
          <div class="gallery-thumbs">
            <% images.forEach((src, i) => { %>
              <button type="button" class="thumb<%= i === 0 ? ' active' : '' %>" data-gallery-thumb="<%= src %>" aria-label="Show photo <%= i + 1 %> of <%= images.length %>"><img src="<%= src %>" alt="" loading="lazy"></button>
            <% }) %>
          </div>
        <% } %>
      </div>
    <% } else { %>
      <div class="placeholder big tone-<%= deal.id % 4 %>" aria-hidden="true"><span><%= deal.product_name.charAt(0).toUpperCase() %></span></div>
    <% } %>
    <h1><%= deal.product_name %></h1>
    <p class="price-tag big"><%= formatEuro(deal.price_cents) %> <small>incl. VAT</small></p>
    <p class="muted small">Final price including VAT for every EU country. The VAT share depends on your delivery country and is calculated by Stripe Tax; the price you pay does not change.</p>
    <% if (deal.description) { %><div class="stack description"><% for (const para of deal.description.split(/\n{2,}/)) { %><p><%= para %></p><% } %></div><% } %>
  </section>

  <section class="card join-card">
    <p class="counter"><span data-count><%= state.count %></span> of <%= state.minBuyers %> buyers joined</p>
    <div class="progress big" aria-hidden="true"><span data-progress data-width="<%= state.percent %>"></span></div>
    <p data-status-line class="status-line">
      <% if (state.status === 'expired') { %>
        This deal did not reach its minimum. Nobody was charged and all saved payment methods were removed.
      <% } else if (state.minimumReached) { %>
        Minimum reached. The deal is on!
      <% } else { %>
        <span data-remaining><%= state.remaining %></span> more needed.
      <% } %>
    </p>
    <p class="deadline">Deadline: <%= formatDate(deal.deadline) %> · <span class="countdown" data-countdown data-seconds="<%= state.secondsLeft %>"></span></p>

    <% if (state.joinable) { %>
      <%- include('partials/join-form') %>
    <% } else if (state.status !== 'expired') { %>
      <div class="notice">This deal is closed to new buyers.</div>
    <% } %>
  </section>
</div>
<script src="/static/js/deal.js"></script>
<%- include('partials/footer') %>
