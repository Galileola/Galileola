<%- include('partials/header') %>
<% const images = (locals.photos || []).map((p, i) => ({ src: photoUrl(p.filename), thumb: thumbUrl(p), alt: p.alt || (i === 0 ? deal.product_name : `${deal.product_name} (${i + 1})`), width: p.width, height: p.height }));
   if (!images.length && deal.image_url) images.push({ src: deal.image_url, thumb: deal.image_url, alt: deal.product_name }); %>
<% const cat = categoryFor(deal.category); %>
<% const mood = state.status === 'expired' ? '' : state.minimumReached ? '' : state.count === 0 ? t('deal.moodFirst') : state.percent >= 70 ? t('deal.moodClose') : state.percent >= 50 ? t('deal.moodHalf') : t('deal.moodStart'); %>
<div class="deal-layout" id="deal" data-slug="<%= deal.slug %>" data-reached="<%= state.minimumReached ? '1' : '0' %>">
  <section class="deal-hero">
    <% if (images.length) { %>
      <div class="gallery" data-gallery>
        <div class="gallery-frame">
          <div class="gallery-track" data-gallery-track>
            <% images.forEach((img, i) => { %>
              <button type="button" class="gallery-slide" data-gallery-open="<%= i %>" aria-label="<%= t('deal.zoomPhoto', { n: i + 1, total: images.length }) %>">
                <img src="<%= img.src %>" alt="<%= img.alt %>"<% if (img.width && img.height) { %> width="<%= img.width %>" height="<%= img.height %>"<% } %> <%- i === 0 ? 'fetchpriority="high"' : 'loading="lazy"' %> decoding="async">
              </button>
            <% }) %>
          </div>
          <% if (images.length > 1) { %>
            <button type="button" class="gallery-nav prev" data-gallery-step="-1" aria-label="<%= t('deal.prevPhoto') %>" hidden>‹</button>
            <button type="button" class="gallery-nav next" data-gallery-step="1" aria-label="<%= t('deal.nextPhoto') %>" hidden>›</button>
            <span class="gallery-count" data-gallery-count aria-hidden="true">1 / <%= images.length %></span>
          <% } %>
        </div>
        <% if (images.length > 1) { %>
          <div class="gallery-thumbs">
            <% images.forEach((img, i) => { %>
              <button type="button" class="thumb<%= i === 0 ? ' active' : '' %>" data-gallery-thumb="<%= i %>" aria-label="<%= t('deal.showPhoto', { n: i + 1, total: images.length }) %>"><img src="<%= img.thumb %>" alt="" loading="lazy"></button>
            <% }) %>
          </div>
        <% } %>
        <dialog class="lightbox" data-lightbox aria-label="<%= deal.product_name %>">
          <button type="button" class="lightbox-close" data-lightbox-close aria-label="<%= t('deal.closePhotos') %>">✕</button>
          <div class="lightbox-track" data-lightbox-track>
            <% images.forEach((img, i) => { %><figure class="lightbox-slide"><img src="<%= img.src %>" alt="<%= img.alt %>" loading="lazy" decoding="async"></figure><% }) %>
          </div>
          <% if (images.length > 1) { %>
            <button type="button" class="gallery-nav prev" data-lightbox-step="-1" aria-label="<%= t('deal.prevPhoto') %>">‹</button>
            <button type="button" class="gallery-nav next" data-lightbox-step="1" aria-label="<%= t('deal.nextPhoto') %>">›</button>
          <% } %>
        </dialog>
      </div>
    <% } else { %>
      <div class="placeholder big tone-<%= deal.id % 4 %>" aria-hidden="true"><span><%= cat.emoji %></span></div>
    <% } %>
    <a class="cat-pill" href="/?category=<%= cat.slug %>#deals"><%= cat.name %></a>
    <% const digital = deal.kind === 'digital'; %>
    <% if (digital) { %><p class="digital-pill"><span aria-hidden="true">⬇️</span> <%= t('deal.digitalBadge') %></p><% } %>
    <h1><%= deal.product_name %></h1>
    <% if (deal.headline) { %><p class="deal-headline"><%= deal.headline %></p><% } %>
    <p class="price-tag big"><%= formatEuro(deal.price_cents) %> <small><%= t('price.inclVat') %></small></p>
    <p class="muted small vat-note"><%= digital ? t('deal.vatNoteDigital') : t('deal.vatNote') %></p>
    <% if (deal.description) { %><div class="stack description"><% for (const para of deal.description.split(/(?:\r?\n\s*){2,}/)) { %><p><%= para %></p><% } %></div><% } %>
    <% if (digital && (locals.files || []).length) { %>
      <section class="digital-files" aria-labelledby="files-title">
        <h2 id="files-title"><%= t('deal.filesTitle') %></h2>
        <ul>
          <% for (const f of files) { %><li><span class="file-name"><%= f.name %></span> <span class="muted small"><%= f.label %> · <%= f.size %></span></li><% } %>
        </ul>
        <p class="muted small"><%= t('deal.digitalNote') %></p>
      </section>
    <% } %>
  </section>

  <section class="card join-card">
    <p class="counter"><%- th('deal.counterHtml', { min: state.minBuyers }, { count: '<span class="counter-num" data-count>' + Number(state.count) + '</span>' }) %></p>
    <div class="goal-track" aria-hidden="true">
      <div class="progress big"><span data-progress data-width="<%= state.percent %>"></span></div>
    </div>
    <p data-status-line class="status-line">
      <% if (state.status === 'expired') { %>
        <%= plain(state.cancelled ? t('deal.cancelled') : t('deal.expired')) %>
      <% } else if (state.minimumReached) { %>
        <%= plain(t('deal.reached')) %>
      <% } else { %>
        <%- th('deal.remainingHtml', { count: state.remaining }, { remaining: '<span data-remaining>' + Number(state.remaining) + '</span>' }) %>
      <% } %>
    </p>
    <% if (mood) { %><p class="mood" data-mood><%= plain(mood) %></p><% } %>
    <p class="deadline"><%= t('deal.deadline', { date: formatDate(deal.deadline) }) %></p>
    <div class="countdown" data-countdown data-seconds="<%= state.secondsLeft %>" role="timer" aria-live="off"></div>

    <% if (state.joinable) { %>
      <%- include('partials/join-form') %>
    <% } else if (locals.notReady && state.status !== 'expired') { %>
      <div class="notice"><%= t('deal.notReady') %></div>
    <% } else if (state.status !== 'expired') { %>
      <div class="notice"><%= plain(t('deal.closed')) %></div>
    <% } %>
  </section>
</div>

<%# The EU notice on the legal guarantee is about goods; downloads don't show it. %>
<% if (!digital) { %><%- include('partials/guarantee-notice') %><% } %>

<% if (state.joinable) { %>
  <section class="card share-card">
    <h2><%= plain(t('deal.shareTitle')) %></h2>
    <p class="muted"><%= t('deal.shareText') %></p>
    <%- include('partials/share', { shareUrl: baseUrl + '/deals/' + deal.slug + '?lang=' + lang, shareText: t('deal.shareMessage', { name: deal.headline || deal.product_name }) }) %>
  </section>
<% } %>
<script src="<%= asset('/static/js/deal.js') %>"></script>
<%- include('partials/footer') %>
