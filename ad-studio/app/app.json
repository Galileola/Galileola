{
  "expo": {
    "name": "Ad Studio",
    "slug": "ad-studio",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0E0F13",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.galileola.adstudio",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.galileola.adstudio",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0E0F13"
      }
    },
    "web": {
      "name": "Ad Studio",
      "shortName": "Ad Studio",
      "themeColor": "#0E0F13",
      "backgroundColor": "#0E0F13",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#0E0F13"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Ad Studio uses your photos to make ads from your product pictures.",
          "cameraPermission": "Ad Studio uses the camera to photograph your product.",
          "microphonePermission": "Ad Studio records sound when you film a product video."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Ad Studio saves finished ads to your photo library.",
          "savePhotosPermission": "Ad Studio saves finished ads to your photo library.",
          "granularPermissions": [
            "photo",
            "video"
          ]
        }
      ],
      "expo-video"
    ],
    "icon": "./assets/icon.png"
  }
}
