# Copy to .env on your server. Never put these keys in the app itself.

# Claude (art director, slogans, scripts, captions): https://console.anthropic.com -> API Keys
ANTHROPIC_API_KEY=

# fal.ai (images, cut-outs, video, voices, presenter videos): https://fal.ai -> Dashboard -> Keys
FAL_KEY=

# The app password: the app must send it, so strangers can't spend your credits.
APP_TOKEN=

PORT=3000

# Where the database and the pictures are kept.
DATA_DIR=data

# The server's public address, e.g. https://ads.example.com. Needed for
# publishing and for the client review links. Render sets RENDER_EXTERNAL_URL itself.
# PUBLIC_URL=

# One-click publishing (optional). See README: "Publishing setup".
# META_APP_ID=
# META_APP_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Optional tuning
# JOB_TTL_DAYS=60            # how long finished ads are kept
# MAX_RUNNING_JOBS=3         # ads made at the same time; the rest wait in a queue
# CLAUDE_MODEL=claude-opus-5-5
# VIDEO_MODEL=fal-ai/kling-video/v3/pro/image-to-video
# AVATAR_MODEL=fal-ai/bytedance/omnihuman/v1.5
