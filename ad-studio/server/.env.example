# Copy to .env on your server. Never put these keys in the app itself.

# Claude (art director): https://console.anthropic.com -> API Keys
ANTHROPIC_API_KEY=

# fal.ai (GPT Image 2, Nano Banana Pro, product cut-out, Kling video): https://fal.ai -> Dashboard -> Keys
FAL_KEY=

# Optional: the app must send this token, so strangers can't spend your credits.
# Put the same value in the app's Settings (or EXPO_PUBLIC_APP_TOKEN).
APP_TOKEN=

PORT=3000

# Optional tuning
# OUTPUT_DIR=output          # where banners and videos are stored
# JOB_TTL_HOURS=48           # how long finished ads are kept
# MAX_RUNNING_JOBS=3         # ads made at the same time
# CLAUDE_MODEL=claude-opus-5-5
# VIDEO_MODEL=fal-ai/kling-video/v3/pro/image-to-video
# FFMPEG_PATH=ffmpeg
# FFPROBE_PATH=ffprobe
