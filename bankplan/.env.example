# Copy to .env.local and fill in. Both Supabase values are public (safe in the browser).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# AI helper (server only, never shown in the browser).
# ANTHROPIC_API_KEY: secret key from console.anthropic.com. Keep it out of the code and the chat.
# ANTHROPIC_MODEL: the Claude model ID to use.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
